# ==============================================================
# TestPilot Platform — Environment Variables
# Copy this file to .env and fill in real values.
# NEVER commit your .env file to version control.
# ==============================================================

# --- PostgreSQL (Docker Compose) ---
POSTGRES_USER=testpilot
POSTGRES_PASSWORD=change_this_password
POSTGRES_DB=testpilot

# --- Backend ---
ENVIRONMENT=development
DATABASE_URL=sqlite:///./testpilot.db
# For PostgreSQL: DATABASE_URL=postgresql://testpilot:change_this_password@localhost:5432/testpilot
SECRET_KEY=change-this-to-a-long-random-string-in-production
CORS_ORIGINS=http://localhost:5173
ARTIFACTS_DIR=./artifacts
MAX_UPLOAD_SIZE_MB=10
PLAYWRIGHT_HEADLESS=true
PLAYWRIGHT_TIMEOUT_MS=30000

# --- Frontend ---
VITE_API_URL=http://localhost:8000
